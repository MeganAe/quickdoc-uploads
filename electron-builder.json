{
  "appId": "com.quickdoc.desktop",
  "productName": "Portail Documents",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    ".output/**/*",
    "public/**/*",
    "electron/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "public/favicon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true
  }
}
